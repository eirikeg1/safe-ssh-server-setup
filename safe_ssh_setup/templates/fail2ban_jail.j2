# Fail2Ban SSH Jail Configuration
# Generated by safe-ssh-setup on {{ timestamp }}
#
# The jail and filter are named "sshd" on every supported distro. Fail2Ban
# ships filter.d/sshd.conf only — naming the filter after the systemd unit
# ("ssh" on Debian) means the jail fails to start.

[DEFAULT]
banaction = {{ banaction }}
banaction_allports = {{ banaction_allports }}

[sshd]
enabled = true
port = {{ ssh_port }}
filter = sshd
maxretry = {{ f2b.max_retry }}
findtime = {{ f2b.find_time }}
bantime = {{ f2b.ban_time }}
backend = {{ backend }}
{% if backend != "systemd" %}
logpath = %(sshd_log)s
{% endif %}
